#: app.py:493
#, python-format
msgid "Apply %(n)skg/ha N, %(p)skg/ha P, %(k)skg/ha K for %(crop)s"
msgstr "%(crop)s साठी %(n)s किग्रॅ/हेक्टर N, %(p)s किग्रॅ/हेक्टर P, %(k)s किग्रॅ/हेक्टर K चा वापर करा"

#: app.py:509
msgid "Apply all fertilizers as basal dose before sowing"
msgstr "पेरणीपूर्वी सर्व खते बेसल डोस म्हणून वापरा"

#: app.py:514
msgid "50% N&K as basal, 50% N&K after 3-4 weeks. All P as basal."
msgstr "५०% N आणि K बेसल म्हणून, ५०% N आणि K ३-४ आठवड्यांनंतर. सर्व P बेसल म्हणून."

#: app.py:520
msgid "40% N&K basal, 40% at 25 days, 20% at 45 days. All P basal."
msgstr "४०% N आणि K बेसल, ४०% २५ दिवसांनी, २०% ४५ दिवसांनी. सर्व P बेसल."

#: app.py:525
msgid "Focus on P&K for flower/fruit development. Reduce N."
msgstr "फुल/फळ विकासासाठी P आणि K वर लक्ष केंद्रित करा. N कमी करा."

#: app.py:529
msgid "Minimal fertilizer. Focus on K for fruit filling."
msgstr "किमान खत. फळ भरण्यासाठी K वर लक्ष केंद्रित करा."


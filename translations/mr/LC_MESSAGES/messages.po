#: app.py:129
#, python-format
msgid "Predicted yield for %(crop)s: %(yield_pred)s hg/ha"
msgstr "अपेक्षित पीक उत्पादन %(crop)s साठी: %(yield_pred)s हेक्टोग्राम/हेक्टर"

#: app.py:140
#, python-format
msgid "Estimated yield for %(crop)s: %(yield_pred)s hg/ha"
msgstr "अंदाजित पीक उत्पादन %(crop)s साठी: %(yield_pred)s हेक्टोग्राम/हेक्टर"

#: app.py:175 app.py:181
msgid "High"
msgstr "जास्त"

#: app.py:176 app.py:182
msgid "Medium"
msgstr "मध्यम"

#: app.py:177 app.py:183
msgid "Low"
msgstr "कमी"

#: app.py:181
msgid "Apply fungicide, improve drainage, reduce plant density"
msgstr "बुरशीनाशक वापरा, पाण्याचा निचरा सुधारा, लागवडीची घनता कमी करा"

#: app.py:182
msgid "Monitor crops closely, ensure proper ventilation"
msgstr "पिकांवर बारकाईने लक्ष ठेवा, योग्य वायुवीजन सुनिश्चित करा"

#: app.py:183
msgid "Continue regular monitoring, maintain good practices"
msgstr "नियमित देखरेख सुरू ठेवा, चांगल्या पद्धतींचा अवलंब करा"

#: app.py:189
msgid "Monitor regularly"
msgstr "नियमित देखरेख करा"

#: app.py:190
#, python-format
msgid "Disease risk level: %(risk_level)s"
msgstr "रोग धोक्याची पातळी: %(risk_level)s"

#: app.py:213
msgid ""
"Low rainfall expected. Consider drought-resistant crops and irrigation "
"planning."
msgstr "कमी पावसाची अपेक्षा आहे. दुष्काळ प्रतिरोधक पिके आणि सिंचनाचे नियोजन करा."

#: app.py:215
msgid "High rainfall expected. Ensure proper drainage and flood management."
msgstr "जास्त पावसाची अपेक्षा आहे. पाण्याचा योग्य निचरा आणि पूर व्यवस्थापन सुनिश्चित करा."

#: app.py:217
msgid "Normal rainfall expected. Good conditions for most crops."
msgstr "सामान्य पावसाची अपेक्षा आहे. बहुतेक पिकांसाठी चांगल्या परिस्थिती आहेत."

#: app.py:225
#, python-format
msgid "Weather prediction for %(year)s: %(rainfall_pred)smm rainfall"
msgstr "वर्ष %(year)s साठी हवामान अंदाज: %(rainfall_pred)s मिमी पाऊस"

#: app.py:251
msgid "Fertilizer recommendation generated successfully"
msgstr "खत शिफारस यशस्वीरित्या तयार झाली"

#: app.py:265
msgid "Fertilizer recommendation generated successfully (estimated values)"
msgstr "खत शिफारस यशस्वीरित्या तयार झाली (अंदाजित मूल्ये)"

#: app.py:266
msgid "Recommendations based on general agricultural guidelines"
msgstr "सामान्य कृषी मार्गदर्शक तत्त्वांवर आधारित शिफारसी"

#: app.py:271
#, python-format
msgid "Unable to generate recommendation: %(error)s"
msgstr "शिफारस तयार करण्यात अक्षम: %(error)s"

#: app.py:299
msgid "Crop recommendations generated successfully"
msgstr "पीक शिफारसी यशस्वीरित्या तयार झाल्या"

#: app.py:334
msgid "Your question has been posted successfully!"
msgstr "तुमचा प्रश्न यशस्वीरित्या पोस्ट झाला आहे!"

#: app.py:335
msgid "2-4 hours"
msgstr "२-४ तास"

#: app.py:361
#, python-format
msgid "Found %(count)s farmers in your area"
msgstr "तुमच्या परिसरात %(count)s शेतकरी सापडले"

#: app.py:378
msgid "Negotiable"
msgstr "वाटाघाटी करता येईल"

#: app.py:387
msgid "Your listing has been posted successfully!"
msgstr "तुमची सूची यशस्वीरित्या पोस्ट झाली आहे!"

#: app.py:428
msgid "Low rainfall: Increased fertilizer needs"
msgstr "कमी पाऊस: खतांची वाढलेली गरज"

#: app.py:433
msgid "High rainfall: Reduced N&P, increased K for leaching prevention"
msgstr "जास्त पाऊस: N आणि P कमी, K वाढवा (गळती टाळण्यासाठी)"

